# ─── DATABASE (REQUIRED) ─────────────────────────────────────────────────────
# SQLite database file path. If not set, application will fail to start.
# Production: use an absolute path or volume-mounted path
# Development: relative path creates DB in project root
DATABASE_URL="./rozgarvaani.db"

# ─── ADMIN AUTHENTICATION ─────────────────────────────────────────────────────
# Admin panel password. MUST be changed in production.
# Default for development only: admin123
ADMIN_PASSWORD="admin123"

# ─── GEMINI (legacy fallback) ────────────────────────────────────────────────
# Keep existing Gemini key for backward-compat fallback only.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ─── NVIDIA Nemotron Nano 9B (Primary AI Model) ───────────────────────────────
# Required for the multi-agent pipeline.
# Obtain a key from: https://integrate.api.nvidia.com
# NEVER commit a real key. Set via secrets/environment only.
NVIDIA_API_KEY="your_new_rotated_key"

# NVIDIA model identifier — do NOT change unless upgrading model.
NVIDIA_MODEL="nvidia/nvidia-nemotron-nano-9b-v2"

# NVIDIA OpenAI-compatible base URL — do NOT change.
NVIDIA_API_BASE="https://integrate.api.nvidia.com/v1"

# ─── APP CONFIG ───────────────────────────────────────────────────────────────
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# ─── WEB SCRAPER CONFIG ────────────────────────────────────────────────────────
# Enable/disable automated web scraper for government job portals
# Set to "false" to disable, or "true" (default) to enable
# When enabled, scraper runs automatically every 15 minutes after server startup
SCRAPER_ENABLED="true"

# Target website for web scraping (default: sarkariresult.com)
SCRAPER_TARGET_URL="https://www.sarkariresult.com/"

# Scraper timeout in milliseconds (default: 15000)
SCRAPER_TIMEOUT="15000"

# Maximum retry attempts for failed scraper requests (default: 3)
SCRAPER_MAX_RETRIES="3"
