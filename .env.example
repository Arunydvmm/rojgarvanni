# ─── DATABASE (REQUIRED) ─────────────────────────────────────────────────────
# PostgreSQL connection string. If not set, application will fail to start.
# Format: postgresql://user:password@host:port/database
# Production: use environment-specific credentials and host
# Development: local PostgreSQL instance
DATABASE_URL="postgresql://user:password@localhost:5432/rozgarvaani"

# ─── ADMIN AUTHENTICATION ─────────────────────────────────────────────────────
# Admin panel password. MUST be changed in production.
# Default for development only: admin123
ADMIN_PASSWORD="admin123"

# ─── GEMINI (legacy fallback) ────────────────────────────────────────────────
# Keep existing Gemini key for backward-compat fallback only.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ─── NVIDIA Nemotron Nano 9B (Primary AI Model) ───────────────────────────────
# Required for both multi-agent pipeline AND chatbot
# Obtain a key from: https://integrate.api.nvidia.com
# NEVER commit a real key. Set via secrets/environment only.
NVIDIA_API_KEY="your_nvidia_api_key_here"

# NVIDIA model identifier — do NOT change unless upgrading model.
NVIDIA_MODEL="nvidia/nvidia-nemotron-nano-9b-v2"

# NVIDIA OpenAI-compatible base URL — do NOT change.
NVIDIA_API_BASE="https://integrate.api.nvidia.com/v1"

# ─── APP CONFIG ───────────────────────────────────────────────────────────────
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# ─── WEB SCRAPER CONFIG ────────────────────────────────────────────────────────
# Enable/disable automated web scraper for government job portals
# Set to "false" to disable, or "true" (default) to enable
# When enabled, scraper runs automatically every 15 minutes after server startup
SCRAPER_ENABLED="true"

# RapidAPI Sarkari Result API Key (1000 requests/month limit)
# Get it from: https://rapidapi.com/sarkari-result-sarkari-result-default/api/sarkari-result
# Endpoints: /jobs, /admissions, /results
SARKARI_RESULT_API_KEY="your_rapidapi_key_here"

# Scraper timeout in milliseconds (default: 15000)
SCRAPER_TIMEOUT="15000"

# Maximum retry attempts for failed scraper requests (default: 2 for API to respect limits)
SCRAPER_MAX_RETRIES="2"

# ─── JOB CHATBOT CONFIG ───────────────────────────────────────────────────────
# Chatbot uses the SAME NVIDIA_API_KEY as main pipeline (no separate key needed)
# Configuration matches nvidia-config.yaml:
#   - provider: openai
#   - model: nvidia/nvidia-nemotron-nano-9b-v2
#   - apiBase: https://integrate.api.nvidia.com/v1
#   - roles: chat, edit, apply
